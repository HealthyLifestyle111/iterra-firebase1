rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == 'admin@iterrawellness.com';
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Associates collection (existing)
    match /associates/{associateId} {
      allow read: if true; // Public read for referral lookups
      allow create: if isAuthenticated() && 
                      request.resource.data.email == request.auth.token.email;
      allow update: if isAuthenticated() && 
                      (request.auth.uid == associateId || 
                       request.auth.token.email == resource.data.adminEmail);
      allow delete: if isAuthenticated() && 
                      request.auth.token.email == resource.data.adminEmail;
    }
    
    // Wellness Intakes collection
    match /wellnessIntakes/{intakeId} {
      allow read: if isAuthenticated() && 
                    (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                      (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Specialized Intakes collection
    match /specializedIntakes/{intakeId} {
      allow read: if isAuthenticated() && 
                    (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                      (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Services collection
    match /services/{serviceId} {
      allow read: if true; // Public read
      allow write: if isAdmin(); // Only admins can modify services
    }
    
    // Consultations collection
    match /consultations/{consultationId} {
      allow read: if isAuthenticated() && 
                    (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                      (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Manifestations collection
    match /manifestations/{manifestationId} {
      allow read: if isAuthenticated() && 
                    (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Training Content collection
    match /trainingContent/{contentId} {
      allow read: if isAuthenticated(); // All authenticated users can read
      allow write: if isAdmin(); // Only admins can modify
    }
    
    // Monthly Updates collection
    match /monthlyUpdates/{updateId} {
      allow read: if isAuthenticated(); // All authenticated users can read
      allow write: if isAdmin(); // Only admins can modify
    }
  }
}
